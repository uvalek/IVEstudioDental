# El export original de Claude Design pesa 17 MB y no sirve para nada en
# producción. Se conserva en la computadora como respaldo, fuera del repo.
/_originales/
IV Estudio Dental.html

# Las fotos sin optimizar pesan 13 MB. Al sitio sólo suben las versiones
# ligeras de assets/img/. Los originales quedan en la computadora, dentro de
# _originales/assets-raw/, por si hay que regenerarlas.
/herramientas/originales/*
!/herramientas/originales/.gitkeep
